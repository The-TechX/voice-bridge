BIND_ADDR=127.0.0.1
VOICE_BRIDGE_PORT=8765
FISH_API_KEY=
# Optional: default Fish Audio voice/model reference ID.
FISH_REFERENCE_ID=

# Conversational streaming TTS (ElevenLabs). Keep the key outside the repo.
ELEVENLABS_API_KEY_PATH=/home/ubuntu/elevenlabsapikey
ELEVENLABS_MODEL=eleven_flash_v2_5
ELEVENLABS_VOICE_ID=8mBRP99B2Ng2QwsJMFQl
ELEVENLABS_STREAM_WORDS=7

# Generate locally; do not commit the private key.
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:push@tchx.dev

# Conversational agent endpoint. Streaming turns use <AGENT_URL>/turn/stream.
AGENT_URL=http://host.docker.internal:8781
AGENT_TIMEOUT_SECONDS=60

# Local speech-to-text service.
STT_URL=http://cme-whisper-stt:8000
STT_TIMEOUT_SECONDS=30
